---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const services = (await getCollection('services'))
        .filter(s => s.data.category === 'creative')
        .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog'))
        .filter(p => p.data.category === 'creative')
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
        <head>
                <BaseHead title={`Creating — ${SITE_TITLE}`} description="Applications, music, and digital experiences built with craft and intention." />
        </head>
        <body>
                <Header />
                <main class="wide">
                        <section class="page-header">
                                <span class="tag tag-creative">Creative</span>
                                <p class="lead">Applications, music, and digital experiences built with craft and intention.</p>
                        </section>

                        <section class="projects-grid">
                                {services.map(s => s.data.link ? (
                                        <a class="project-card project-card--link" href={s.data.link} target="_blank" rel="noopener noreferrer">
                                                {s.data.type && <div class="project-type">{s.data.type}</div>}
                                                <h3>{s.data.title}</h3>
                                                <p>{s.data.description}</p>
                                        </a>
                                ) : (
                                        <div class="project-card">
                                                {s.data.type && <div class="project-type">{s.data.type}</div>}
                                                <h3>{s.data.title}</h3>
                                                <p>{s.data.description}</p>
                                        </div>
                                ))}
                        </section>

                        {posts.length > 0 && (
                                <section class="posts-section">
                                        <h2>Creative Notes</h2>
                                        <ul class="post-list">
                                                {posts.map(post => (
                                                        <li class="post-item">
                                                                <a href={`/blog/${post.id}/`}>
                                                                        <span class="post-title">{post.data.title}</span>
                                                                        <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
                                                                </a>
                                                        </li>
                                                ))}
                                        </ul>
                                </section>
                        )}

                </main>
                <Footer />
        </body>
</html>

<style>
        .page-header {
                padding: 1rem 0 0.5rem;
        }
        .page-header .tag { margin-bottom: 0.75rem; display: block; }
        .lead {
                font-size: 1rem;
                color: var(--text-muted);
                margin: 0;
        }

        .projects-grid {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                margin: 2rem 0;
        }
        .project-card {
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 1rem 1.125rem;
                text-decoration: none;
                display: block;
                color: inherit;
        }
        .project-card--link {
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .project-card--link:hover {
                border-color: var(--accent);
                box-shadow: var(--shadow-sm);
        }
        .project-card--link:hover h3 {
                color: var(--accent);
        }
        .project-type {
                font-size: 0.75rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--text-faint);
                margin-bottom: 0.25rem;
        }
        .project-card h3 {
                margin-bottom: 0.25rem;
        }
        .project-card p {
                color: var(--text-muted);
                margin: 0;
                line-height: 1.5;
        }

        .posts-section { margin: 3rem 0; }
        .posts-section h2 { font-size: 1.125rem; font-weight: 600; margin-bottom: 1rem; letter-spacing: -0.01em; }
        .post-list {
                list-style: none;
                margin: 0;
                padding: 0;
                border-top: 1px solid var(--border);
        }
        .post-item { border-bottom: 1px solid var(--border-subtle); }
        .post-item a {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                padding: 0.85rem 0;
                color: var(--text);
                text-decoration: none;
                gap: 1rem;
                transition: color 0.15s ease;
        }
        .post-item a:hover .post-title { color: var(--accent); }
        .post-title { font-weight: 500; }
        .post-date { color: var(--text-faint); font-size: 0.85rem; white-space: nowrap; }

        .cta-section {
                margin: 3rem 0 1rem;
                padding: 2.5rem;
                background: var(--bg-subtle);
                border: 1px solid var(--border);
                border-radius: var(--radius);
        }
        .cta-section h2 { margin-bottom: 0.5rem; }
        .cta-section p { color: var(--text-muted); margin-bottom: 1.25rem; }
        .btn-primary {
                display: inline-block;
                padding: 0.6em 1.4em;
                background: var(--accent);
                color: #fff;
                border-radius: var(--radius-sm);
                font-weight: 600;
                font-size: 0.95rem;
                text-decoration: none;
                transition: background 0.15s ease;
        }
        .btn-primary:hover { background: var(--accent-hover); color: #fff; }

        @media (max-width: 640px) {
                .projects-grid { grid-template-columns: 1fr; }
                .post-item a { flex-direction: column; gap: 0.15rem; }
        }
</style>

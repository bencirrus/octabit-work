---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-content">
					<h1>Adapt to AI.</h1>
					<p class="lead">
						Strategic advisory and creative work at the intersection of technology, business, and culture.
					</p>
				</div>
				<div class="hero-mark" aria-hidden="true">
					<img src="/images/uploads/octabit.work.logo.png" alt="" />
				</div>
			</section>

			<hr />

			<section class="offerings">
				<div class="offering-col">
					<a href="/advising" class="tag tag-advisory">Advisory</a>
					<p>AI strategy, digital transformation, and technology leadership for organizations navigating rapid change.</p>
				</div>
				<div class="offering-col">
					<a href="/creating" class="tag tag-creative">Creative</a>
					<p>Applications, music, and digital experiences built with craft and intention.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		position: relative;
		padding: 4rem 0 3rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		overflow: hidden;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 560px;
	}

	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
		letter-spacing: -0.03em;
	}

	.lead {
		font-size: 1.2rem;
		color: var(--text-muted);
		margin: 0;
	}

	.hero-mark {
		position: absolute;
		right: -2rem;
		top: 50%;
		transform: translateY(-50%);
		width: 260px;
		pointer-events: none;
		user-select: none;
	}

	.hero-mark img {
		width: 100%;
		height: auto;
		border-radius: 0;
		opacity: 0.06;
		filter: grayscale(1);
	}

	@media (prefers-color-scheme: dark) {
		.hero-mark img {
			opacity: 0.04;
			filter: grayscale(1) invert(1);
		}
	}

	hr { margin: 2rem 0; }

	.offerings {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		padding: 2rem 0;
	}

	.offering-col .tag {
		margin-bottom: 0.75rem;
		display: inline-block;
		cursor: pointer;
		text-decoration: none;
		transition: opacity 0.15s ease;
	}
	.offering-col .tag:hover { opacity: 0.75; }

	.offering-col p {
		color: var(--text-muted);
		margin: 0;
	}

	@media (max-width: 600px) {
		.hero { flex-direction: column; align-items: flex-start; }
		.hero h1 { font-size: 2.5rem; }
		.hero-mark { width: 160px; right: -1rem; }
		.offerings { grid-template-columns: 1fr; gap: 2rem; }
	}
</style>

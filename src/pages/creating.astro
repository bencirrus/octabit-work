---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter(p => p.data.category === 'creative')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Creating — ${SITE_TITLE}`} description="Applications, music, and digital experiences built with craft and intention." />
	</head>
	<body>
		<Header />
		<main class="wide">
			<section class="page-header">
				<span class="tag tag-creative">Creative</span>
				<h1>Creating</h1>
				<p class="lead">Applications, music, and digital experiences built with craft and intention.</p>
			</section>

			<section class="projects-grid">
				<div class="project-card">
					<div class="project-meta">
						<span class="project-type">Application</span>
					</div>
					<h3>OctaBit.work</h3>
					<p>This site — a clean, CMS-powered blog and portfolio built on Astro and Cloudflare, designed for speed and ease of updating.</p>
				</div>
				<div class="project-card">
					<div class="project-meta">
						<span class="project-type">Application</span>
					</div>
					<h3>AI Workflow Tools</h3>
					<p>Custom internal tools and automation pipelines that help small teams do more with AI — without requiring engineering resources.</p>
				</div>
				<div class="project-card">
					<div class="project-meta">
						<span class="project-type">Music</span>
					</div>
					<h3>Original Compositions</h3>
					<p>Instrumental and electronic music exploring the space between structure and improvisation. Released independently and in collaboration.</p>
				</div>
				<div class="project-card">
					<div class="project-meta">
						<span class="project-type">Writing</span>
					</div>
					<h3>Notes & Essays</h3>
					<p>Short-form writing on technology, creativity, and the ways humans and machines are learning to work together.</p>
				</div>
			</section>

			{posts.length > 0 && (
				<section class="posts-section">
					<h2>Creative Notes</h2>
					<ul class="post-list">
						{posts.map(post => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<section class="cta-section">
				<h2>Work together</h2>
				<p>Interested in a collaboration, commission, or project? Get in touch.</p>
				<a href="mailto:hello@octabit.work" class="btn-primary">hello@octabit.work</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: 3rem 0 2rem;
	}
	.page-header .tag { margin-bottom: 0.75rem; }
	.page-header h1 { margin-bottom: 0.5rem; }
	.lead {
		font-size: 1.15rem;
		color: var(--text-muted);
		margin: 0;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin: 2rem 0;
	}
	.project-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.project-card:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow-sm);
	}
	.project-meta { margin-bottom: 0.5rem; }
	.project-type {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	.project-card h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}
	.project-card p {
		color: var(--text-muted);
		font-size: 0.95rem;
		margin: 0;
	}

	.posts-section { margin: 3rem 0; }
	.posts-section h2 { margin-bottom: 1rem; }
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.post-item { border-bottom: 1px solid var(--border-subtle); }
	.post-item a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 0.85rem 0;
		color: var(--text);
		text-decoration: none;
		gap: 1rem;
		transition: color 0.15s ease;
	}
	.post-item a:hover .post-title { color: var(--accent); }
	.post-title { font-weight: 500; }
	.post-date { color: var(--text-faint); font-size: 0.85rem; white-space: nowrap; }

	.cta-section {
		margin: 3rem 0 1rem;
		padding: 2.5rem;
		background: var(--bg-subtle);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.cta-section h2 { margin-bottom: 0.5rem; }
	.cta-section p { color: var(--text-muted); margin-bottom: 1.25rem; }
	.btn-primary {
		display: inline-block;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: #fff;
		border-radius: var(--radius-sm);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: background 0.15s ease;
	}
	.btn-primary:hover { background: var(--accent-hover); color: #fff; }

	@media (max-width: 640px) {
		.projects-grid { grid-template-columns: 1fr; }
		.post-item a { flex-direction: column; gap: 0.15rem; }
	}
</style>

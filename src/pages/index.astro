---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">OctaBit.work</p>
				<h1>Adapt to AI.</h1>
				<p class="lead">
					Strategic advisory and creative work at the intersection of technology, business, and culture.
				</p>
			</section>

			<hr />

			<section class="offerings">
				<div class="offering-col">
					<span class="tag tag-advisory">Advisory</span>
					<p>AI strategy, digital transformation, and technology leadership for organizations navigating rapid change.</p>
					<a href="/advising" class="section-link">See advisory services &rarr;</a>
				</div>
				<div class="offering-col">
					<span class="tag tag-creative">Creative</span>
					<p>Applications, music, and digital experiences built with craft and intention.</p>
					<a href="/creating" class="section-link">See creative work &rarr;</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 4rem 0 3rem;
	}
	.eyebrow {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 1rem;
	}
	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
		letter-spacing: -0.03em;
	}
	.lead {
		font-size: 1.2rem;
		color: var(--text-muted);
		max-width: 520px;
		margin: 0;
	}

	hr { margin: 2rem 0; }

	.offerings {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		padding: 2rem 0;
	}
	.offering-col .tag { margin-bottom: 0.75rem; display: block; }
	.offering-col p {
		color: var(--text-muted);
		margin-bottom: 1rem;
	}
	.section-link {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}
	.section-link:hover { color: var(--accent-hover); }

	@media (max-width: 600px) {
		.hero h1 { font-size: 2.5rem; }
		.offerings { grid-template-columns: 1fr; gap: 2rem; }
	}
</style>

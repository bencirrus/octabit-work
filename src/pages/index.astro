---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Adapt to AI.</h1>
				<p class="lead">
					Strategic advisory and creative work at the intersection of technology, business, and culture.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 5rem 0 4rem;
	}
	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
		letter-spacing: -0.03em;
	}
	.lead {
		font-size: 1.2rem;
		color: var(--text-muted);
		max-width: 520px;
		margin: 0;
	}

	@media (max-width: 600px) {
		.hero { padding: 3rem 0; }
		.hero h1 { font-size: 2.5rem; }
	}
</style>

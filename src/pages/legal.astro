---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getEntry } from 'astro:content';

const legalEntry = await getEntry('site', 'legal');
const { title, sections } = legalEntry.data;
---

<!doctype html>
<html lang="en">
        <head>
                <BaseHead title={`Legal — ${SITE_TITLE}`} description="Privacy policy, cookie policy, terms of use, accessibility statement, disclaimers, and copyright notice for OctaBit.work." />
        </head>
        <body id="top">
                <Header />

                <main class="prose-page">
                        <h1>{title}</h1>

                        <nav class="legal-nav-bar" aria-label="Legal sections">
                                <div class="legal-nav">
                                        {sections.map(s => (
                                                <a href={`#${s.id}`}>{s.label}</a>
                                        ))}
                                </div>
                        </nav>

                        {sections.map(section => (
                                <section id={section.id}>
                                        <h2>{section.label} <a class="return-top" href="#top" aria-label="Return to top">↩</a></h2>
                                        {section.body.split('\n\n').map(p => <p>{p}</p>)}
                                </section>
                        ))}
                </main>

                <Footer />
        </body>
</html>

<style>
        .legal-nav-bar {
                display: block;
                border-bottom: 1px solid var(--border);
                background: transparent;
                padding: 0 0 1rem;
                margin-bottom: 2rem;
        }

        .legal-nav {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
        }

        .legal-nav a {
                display: inline-block;
                padding: 0.25rem 0;
                color: var(--text-muted);
                text-decoration: none;
                border-bottom: 2px solid transparent;
                font-size: 0.95rem;
                transition: color 0.15s ease, border-color 0.15s ease;
        }
        .legal-nav a:hover,
        .legal-nav a:focus-visible {
                color: var(--text);
                border-bottom-color: var(--accent);
        }

        .return-top {
                margin-left: 0.5rem;
                color: var(--text-muted);
                text-decoration: none;
                font-size: 0.95rem;
        }
        .return-top:hover, .return-top:focus-visible { color: var(--text); }

        .legal-nav-bar {
                width: 100%;
                max-width: 100%;
                box-sizing: border-box;
        }
        .legal-nav {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                width: 100%;
                min-width: 0;
        }
        .legal-nav a {
                min-width: 0;
                flex: 0 1 auto;
        }
        .prose-page {
                width: min(100%, var(--max-width));
                margin: 0 auto;
                padding: 3rem 1.5rem;
        }

        .prose-page h1 {
                font-size: 2rem;
                margin-bottom: 2.5rem;
        }

        .prose-page section {
                margin-bottom: 3rem;
                padding-top: 1rem;
                scroll-margin-top: 6.5rem;
        }

        .prose-page h2 {
                font-size: 1.25rem;
                margin-bottom: 0.75rem;
                padding-bottom: 0.5rem;
                border-bottom: 1px solid var(--border-subtle);
        }

        .prose-page p {
                color: var(--text-muted);
                line-height: 1.75;
                margin-bottom: 1rem;
        }

        @media (max-width: 480px) {
                .legal-nav a { padding: 0.75rem 0.75rem; }
        }
</style>

---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;

const tagClass = category === 'advisory' ? 'tag-advisory' : category === 'creative' ? 'tag-creative' : '';
const tagLabel = category === 'advisory' ? 'Advisory' : category === 'creative' ? 'Creative' : '';
const backHref = category === 'advisory' ? '/advising' : category === 'creative' ? '/creating' : '/';
const backLabel = category === 'advisory' ? 'Advising' : category === 'creative' ? 'Creating' : 'Home';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="post-header">
					<div class="post-meta">
						{tagLabel && <span class={`tag ${tagClass}`}>{tagLabel}</span>}
						<span class="date"><FormattedDate date={pubDate} /></span>
						{updatedDate && (
							<span class="updated">Updated <FormattedDate date={updatedDate} /></span>
						)}
					</div>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
					<a href={backHref} class="back-link">&larr; {backLabel}</a>
				</div>

				{heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt="" />
					</div>
				)}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		padding: 2.5rem 0 2rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2rem;
	}
	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
	}
	.date, .updated {
		color: var(--text-faint);
		font-size: 0.875rem;
	}
	.updated { font-style: italic; }

	.post-header h1 {
		margin-bottom: 0.5rem;
		letter-spacing: -0.02em;
	}
	.description {
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.7;
		margin-bottom: 1.25rem;
	}
	.back-link {
		display: inline-block;
		font-size: 0.875rem;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.back-link:hover { color: var(--accent); }

	.hero-image {
		margin-bottom: 2rem;
	}
	.hero-image img {
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.prose {
		color: var(--text);
		font-size: 1em;
		line-height: 1.7;
	}
	.prose h2, .prose h3 { margin-top: 2rem; }

	@media (max-width: 720px) {
		.post-header h1 { font-size: 1.75rem; }
	}
</style>

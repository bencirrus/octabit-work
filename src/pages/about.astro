---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

const aboutEntry = await getEntry('site', 'about');
const { title } = aboutEntry.data;
const { Content } = await render(aboutEntry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="OctaBit.work — strategic advisory and creative work at the intersection of technology and culture." />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>{title}</h1>
			</section>

			<div class="prose">
				<Content />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		padding: 3rem 0 1.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2rem;
	}
	.page-header h1 { margin: 0; }
	.prose {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text);
	}
	.prose h2 { margin-top: 1.5rem; }
	.prose p { margin-bottom: 1.5rem; }
</style>

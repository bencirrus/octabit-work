---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<span class="copy">&copy; {today.getFullYear()} OctaBit.work LLC</span>
		<div class="footer-links">
			<a href="https://linkedin.com" class="footer-link" target="_blank" rel="noopener noreferrer">Connect</a>
			<a href="/legal" class="footer-link">Legal</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 1.5rem;
		background: var(--bg);
	}

	.footer-inner {
		max-width: var(--max-width-wide);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.copy,
	.footer-link {
		color: var(--text-faint);
		font-size: 0.875rem;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.footer-link:hover {
		color: var(--text-muted);
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	@media (max-width: 480px) {
		.footer-inner { flex-direction: column; align-items: flex-start; }
	}
</style>

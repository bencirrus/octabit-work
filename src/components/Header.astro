---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header id="site-header">
        <nav>
                <a href="/" class="logo-link" aria-label={SITE_TITLE}>
                        <img src="/favicon.svg" alt="" class="logo" />
                        <span class="site-name">OctaBit.work</span>
                </a>
                <div class="nav-links">
                        <HeaderLink href="/advising">Advising </HeaderLink>
                        <HeaderLink href="/creating">| Creating</HeaderLink>
                        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
                                <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                                </svg>
                                <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                                </svg>
                        </button>
                </div>
        </nav>
</header>

<script>
        // Theme toggle — bind on every page load/swap and restore preference
        function initThemeToggle() {
                const btn = document.getElementById('theme-toggle');
                const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                const stored = localStorage.getItem('theme');
                const dark = stored === 'dark' || (stored === null && prefersDark);
                document.documentElement.classList.toggle('dark', dark);

                if (!btn) return;
                if (!btn.__initialized) {
                        btn.addEventListener('click', () => {
                                const isDark = document.documentElement.classList.toggle('dark');
                                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                        });
                        btn.__initialized = true;
                }
        }
        initThemeToggle();
        document.addEventListener('astro:after-swap', initThemeToggle);
</script>

<style>
        header {
                position: sticky;
                top: 0;
                z-index: 100;
                background: var(--bg);
                border-bottom: 1px solid var(--border);
                padding: 0 1.5rem;
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                transition: padding 0.35s ease;
        }

        nav {
                max-width: var(--max-width-wide);
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
        }

        .logo-link {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                text-decoration: none;
                transition: gap 0.35s ease;
                flex: 0 1 auto;
                min-width: 0;
        }

        .logo {
                height: 48px;
                width: auto;
                border-radius: 0;
                transition: height 0.35s ease, filter 0.2s ease;
        }

        .site-name {
                color: var(--text);
                font-size: var(--size-brand);
                font-weight: 500;
                letter-spacing: normal;
                transition: font-size 0.35s ease;
                white-space: nowrap;
        }

        /* Nav height: fixed medium size */
        nav {
                height: 76px;
                transition: height 0.35s ease;
        }

        .nav-links {
                display: flex;
                align-items: center;
                gap: 0.1rem;
                flex: 1 1 auto;
                min-width: 0;
                justify-content: flex-end;
        }

        :global(html.dark) .logo {
                filter: invert(1);
        }

        .theme-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border: none;
                background: transparent;
                color: var(--text-muted);
                border-radius: var(--radius-sm);
                cursor: pointer;
                transition: color 0.15s ease, background 0.15s ease;
                margin-left: 0.1rem;
        }
        .theme-toggle:hover {
                color: var(--text);
                background: var(--bg-subtle);
        }

        .icon-sun { display: none; }
        .icon-moon { display: block; }
        :global(html.dark) .icon-sun { display: block; }
        :global(html.dark) .icon-moon { display: none; }

        @media (max-width: 480px) {
                header { padding: 0 1rem; }
                .logo { height: 44px; }
                nav { height: 64px; }
        }
</style>

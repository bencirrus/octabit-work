---
const today = new Date();
---

<footer>
	<span class="copy">&copy; {today.getFullYear()} OctaBit.work LLC</span>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem 1.5rem;
		background: var(--bg);
		max-width: calc(100% - 3rem);
		margin: 0 auto;
	}

	.copy {
		color: var(--text-faint);
		font-size: 0.875rem;
	}
</style>

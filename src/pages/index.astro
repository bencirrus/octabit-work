---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const advisoryServices = allServices
        .filter(s => s.data.category === 'advisory' && s.data.featured)
        .sort((a, b) => a.data.order - b.data.order);
const creativeServices = allServices
        .filter(s => s.data.category === 'creative' && s.data.featured)
        .sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
        <head>
                <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        </head>
        <body>
                <Header />
                <main>
                        <section class="hero">
                                <h1>Adapt to AI.</h1>
                                <p class="lead">
                                        Strategic advisory and creative work at the intersection of technology, business, and culture.
                                </p>
                        </section>

                        <hr />

                        <section class="offerings">
                                <div class="offering-col">
                                        <a href="/advising" class="tag tag-advisory">Advisory Services</a>
                                        <p class="col-desc">AI strategy, digital transformation, and technology leadership for organizations navigating rapid change.</p>
                                        {advisoryServices.length > 0 && (
                                                <ul class="service-list">
                                                        {advisoryServices.map(s => (
                                                                <li class="service-card">
                                                                        <strong>{s.data.title}</strong>
                                                                        <p>{s.data.description}</p>
                                                                </li>
                                                        ))}
                                                </ul>
                                        )}
                                </div>
                                <div class="offering-col">
                                        <a href="/creating" class="tag tag-creative">Creative Work</a>
                                        <p class="col-desc">Applications, music, and digital experiences built with craft and intention.</p>
                                        {creativeServices.length > 0 && (
                                                <ul class="service-list">
                                                        {creativeServices.map(s => (
                                                                <li class="service-card">
                                                                        <strong>{s.data.title}</strong>
                                                                        <p>{s.data.description}</p>
                                                                </li>
                                                        ))}
                                                </ul>
                                        )}
                                </div>
                        </section>
                </main>
                <Footer />
        </body>
</html>

<style>
        .hero {
                padding: 4rem 0 3rem;
        }
        .hero h1 {
                font-size: 3.5rem;
                margin-bottom: 1rem;
                letter-spacing: -0.03em;
        }
        .lead {
                font-size: 1.2rem;
                color: var(--text-muted);
                max-width: 520px;
                margin: 0;
        }

        hr { margin: 2rem 0; }

        .offerings {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 3rem;
                padding: 2rem 0 3rem;
                align-items: start;
        }

        .offering-col .tag {
                margin-bottom: 0.75rem;
                display: inline-block;
                text-decoration: none;
                transition: opacity 0.15s ease;
        }
        .offering-col .tag:hover { opacity: 0.75; }

        .col-desc {
                color: var(--text-muted);
                margin: 0 0 1.25rem;
        }

        .service-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
        }

        .service-card {
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 1rem 1.125rem;
        }

        .service-card strong {
                display: block;
                font-size: 0.95rem;
                color: var(--text);
                margin-bottom: 0.25rem;
        }

        .service-card p {
                font-size: 0.875rem;
                color: var(--text-muted);
                margin: 0;
                line-height: 1.5;
        }

        @media (max-width: 600px) {
                .hero h1 { font-size: 2.5rem; }
                .offerings { grid-template-columns: 1fr; gap: 2.5rem; }
        }
</style>

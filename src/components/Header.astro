---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header id="site-header">
        <nav>
                <a href="/" class="logo-link" aria-label={SITE_TITLE}>
                        <img src="/favicon.svg" alt="" class="logo" />
                        <span class="site-name">OctaBit.work</span>
                </a>
                <div class="nav-links">
                        <HeaderLink href="/advising">Advising</HeaderLink>
                        <HeaderLink href="/creating">Creating</HeaderLink>
                        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
                                <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                                </svg>
                                <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                                </svg>
                        </button>
                </div>
        </nav>
</header>

<script>
        // Theme toggle — bind on every page load/swap
        function initThemeToggle() {
                const btn = document.getElementById('theme-toggle');
                if (!btn) return;
                btn.addEventListener('click', () => {
                        const dark = !document.documentElement.classList.contains('dark');
                        document.documentElement.classList.toggle('dark', dark);
                        localStorage.setItem('theme', dark ? 'dark' : 'light');
                });
        }
        initThemeToggle();
        document.addEventListener('astro:after-swap', initThemeToggle);

        // Scroll-driven header size
        function initScrollHeader() {
                const header = document.getElementById('site-header');
                if (!header) return;

                function update() {
                        const scrolled = window.scrollY > 10;
                        header!.classList.toggle('scrolled', scrolled);
                }

                update();
                window.addEventListener('scroll', update, { passive: true });
        }

        // Run on first load and after every view transition
        initScrollHeader();
        document.addEventListener('astro:after-swap', initScrollHeader);
</script>

<style>
        header {
                position: sticky;
                top: 0;
                z-index: 100;
                background: var(--bg);
                border-bottom: 1px solid var(--border);
                padding: 0 1.5rem;
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                transition: padding 0.35s ease;
        }

        nav {
                max-width: var(--max-width-wide);
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
        }

        .logo-link {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                text-decoration: none;
                transition: gap 0.35s ease;
        }

        /* Large state (at top) */
        .logo {
                height: 64px;
                width: auto;
                border-radius: 0;
                transition: height 0.35s ease, filter 0.2s ease;
        }

        .site-name {
                font-size: 2rem;
                font-weight: 700;
                color: var(--text);
                letter-spacing: -0.03em;
                transition: font-size 0.35s ease;
                white-space: nowrap;
        }

        /* Scrolled / compact state */
        header.scrolled {
                padding-top: 0;
                padding-bottom: 0;
        }

        header.scrolled .logo {
                height: 32px;
        }

        header.scrolled .site-name {
                font-size: 1rem;
                letter-spacing: -0.01em;
        }

        /* Nav height: tall at top, compact when scrolled */
        nav {
                height: 96px;
                transition: height 0.35s ease;
        }
        header.scrolled nav {
                height: 56px;
        }

        .nav-links {
                display: flex;
                align-items: center;
                gap: 0.25rem;
        }

        :global(html.dark) .logo {
                filter: invert(1);
        }

        .theme-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border: none;
                background: transparent;
                color: var(--text-muted);
                border-radius: var(--radius-sm);
                cursor: pointer;
                transition: color 0.15s ease, background 0.15s ease;
                margin-left: 0.25rem;
        }
        .theme-toggle:hover {
                color: var(--text);
                background: var(--bg-subtle);
        }

        .icon-sun { display: none; }
        .icon-moon { display: block; }
        :global(html.dark) .icon-sun { display: block; }
        :global(html.dark) .icon-moon { display: none; }

        @media (max-width: 480px) {
                header { padding: 0 1rem; }
                .logo { height: 48px; }
                .site-name { font-size: 1.5rem; }
                header.scrolled .logo { height: 28px; }
                header.scrolled .site-name { font-size: 0.95rem; }
                nav { height: 80px; }
                header.scrolled nav { height: 52px; }
        }
</style>

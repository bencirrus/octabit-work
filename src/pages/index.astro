---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const advisoryServices = allServices
        .filter(s => s.data.category === 'advisory' && s.data.featured)
        .sort((a, b) => a.data.order - b.data.order);
const creativeServices = allServices
        .filter(s => s.data.category === 'creative' && s.data.featured)
        .sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
        <head>
                <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        </head>
        <body>
                <Header />
                <main>
                        <section class="hero">
                                <h2>Augment <sub>with</sub> Intelligence (A<sub>w</sub>I)</h2>
                                <p class="lead">
                                        Strategic advisory and creative work at the intersection of technology, business, and culture.
                                </p>
                        </section>

                        <hr />

                        <section class="offerings">
                                <div class="offering-col">
                                        <a href="/advising" class="tag tag-advisory">Advisory Services</a>
                                        <p class="col-desc">AI strategy, digital transformation, and technology leadership for organizations navigating rapid change.</p>
                                        {advisoryServices.length > 0 && (
                                                <div class="service-list">
                                                        {advisoryServices.map(s => s.data.link ? (
                                                                <a class="service-card service-card--link" href={s.data.link} target="_blank" rel="noopener noreferrer">
                                                                        <strong>{s.data.title}</strong>
                                                                        <p>{s.data.description}</p>
                                                                </a>
                                                        ) : (
                                                                <div class="service-card">
                                                                        <strong>{s.data.title}</strong>
                                                                        <p>{s.data.description}</p>
                                                                </div>
                                                        ))}
                                                </div>
                                        )}
                                </div>
                                <div class="offering-col">
                                        <a href="/creating" class="tag tag-creative">Creative Work</a>
                                        <p class="col-desc">Applications, music, and digital experiences built with craft and intention.</p>
                                        {creativeServices.length > 0 && (
                                                <div class="service-list">
                                                        {creativeServices.map(s => s.data.link ? (
                                                                <a class="service-card service-card--link" href={s.data.link} target="_blank" rel="noopener noreferrer">
                                                                        <strong>{s.data.title}</strong>
                                                                        <p>{s.data.description}</p>
                                                                </a>
                                                        ) : (
                                                                <div class="service-card">
                                                                        <strong>{s.data.title}</strong>
                                                                        <p>{s.data.description}</p>
                                                                </div>
                                                        ))}
                                                </div>
                                        )}
                                </div>
                        </section>

                        <section class="hero-bottom">
                                <div class="hero-box">
                                        <h2>&gt; The name</h2>
                                        <p>We aim to bring you the ease of experience of early arcade video games. As technology progresses, console games look better but more complicated for those who don’t have the time or the patience to master the advanced game play, defeating the purpose of games for most people—fun! The name with the simple logo is a play on 8-bit games/graphics.</p>
                                </div>
                        </section>
                </main>
                <Footer />
        </body>
</html>

<style>
        .hero {
                padding: 1.333rem 0 1.5rem;
        }
        .hero h1 {
                font-size: 3.5rem;
                margin-bottom: 1rem;
                letter-spacing: -0.03em;
        }
        .lead {
                font-size: 1.2rem;
                color: var(--text-muted);
                max-width: 520px;
                margin: 0;
        }

        hr { margin: 2rem 0; }

        .offerings {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 3rem;
                padding: 2rem 0 3rem;
                align-items: start;
        }

        .offering-col .tag {
                margin-bottom: 0.75rem;
                display: inline-block;
                text-decoration: none;
                transition: opacity 0.15s ease;
        }
        .offering-col .tag:hover { opacity: 0.75; }

        .col-desc {
                color: var(--text-muted);
                margin: 0 0 1.25rem;
        }

        .service-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
        }

        .service-card {
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 1rem 1.125rem;
                text-decoration: none;
                display: block;
                color: inherit;
        }

        .service-card strong {
                display: block;
                font-size: 1rem;
                font-weight: 600;
                color: var(--text);
                margin-bottom: 0.25rem;
        }

        .service-card p {
                font-size: 0.9375rem;
                color: var(--text-muted);
                margin: 0;
                line-height: 1.5;
        }

        .service-card--link {
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .service-card--link:hover {
                border-color: var(--accent);
                box-shadow: var(--shadow-sm);
        }
        .service-card--link:hover strong {
                color: var(--accent);
        }

        .hero-bottom {
                margin-top: 2rem;
        }
        .hero-box {
                max-width: var(--max-width);
                margin: 0 auto;
                padding: 1.25rem 1.5rem;
                background: var(--bg-card);
                border: none;
                border-radius: var(--radius);
        }
        .hero-box h2 {
                font-size: 1rem;
                margin: 0 0 0.5rem;
                font-weight: 700;
        }
        .hero-box p {
                margin: 0;
                color: var(--text-muted);
                font-size: 0.9375rem;
                line-height: 1.5;
        }

        @media (max-width: 600px) {
                .hero h1 { font-size: 2.5rem; }
                .offerings { grid-template-columns: 1fr; gap: 2.5rem; }
        }
</style>
